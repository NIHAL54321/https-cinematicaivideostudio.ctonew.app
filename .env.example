# ------------------------------------------------------------------
# Cinematic AI Video Studio — environment variables (Phase 1)
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# All provider API keys are SERVER-SIDE ONLY. Never reference them from
# client components or expose them via NEXT_PUBLIC_*.
# ------------------------------------------------------------------

# --- Core ---
# Base URL of the app (used for cookies and absolute URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign/verify cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=please-generate-a-random-32-byte-secret

# --- PostgreSQL (Prisma) ---
# Local dev (direct install):  postgresql://cinema:cinema_dev_password@localhost:5432/cinema_studio
# Docker Compose:             postgresql://cinema:cinema_dev_password@localhost:5432/cinema_studio
DATABASE_URL=postgresql://cinema:cinema_dev_password@localhost:5432/cinema_studio

# --- Redis (rate limits + BullMQ queues) ---
# Leave empty to fall back to in-memory rate limiting (single process).
REDIS_URL=redis://localhost:6379

# --- S3-compatible object storage (MinIO) ---
# Docker Compose defaults: endpoint http://localhost:9000, keys minioadmin/minioadmin.
# For a MinIO binary on the same host use the same values.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cinema-studio
# Force path-style addressing (required for MinIO, also works with most S3-compatibles).
S3_FORCE_PATH_STYLE=true
# Public URL prefix for generated object URLs (blank = derive from endpoint).
S3_PUBLIC_URL=

# --- Session cookie ---
# In production set to true (requires HTTPS).
COOKIE_SECURE=false
# Session lifetime in days.
SESSION_TTL_DAYS=30

# --- AI provider keys (Phase 1: optional) — all server-side only. ---
# Leave empty in Phase 1 — the AI studio pages will show "Provider Not Connected"
# driven by the real orchestrator state (GET /api/ai/status). NEVER use
# NEXT_PUBLIC_* for these; NEVER import them from client components.
#
# Which env var enables which capability (single source of truth lives in
# src/lib/ai/providers/env-keys.ts — add a provider there + here):
#
#   OPENAI_API_KEY           → reasoning, scripts, SEO, translation, subtitles,
#                             speech-to-text (whisper), images, TTS, vision detections
#   ANTHROPIC_API_KEY        → reasoning, scripts, SEO, translation, subtitles
#   GOOGLE_AI_API_KEY        → reasoning, scripts, SEO, translation, speech-to-text,
#   (or GOOGLE_API_KEY)        images (Imagen), video (Veo), TTS, vision detections
#   REPLICATE_API_TOKEN      → images, video, upscaling, enhancement, music,
#                             sound effects, TTS, lip sync, speech-to-text, detections
#   RUNWAY_API_KEY           → video generation, video enhancement, upscaling
#   ELEVENLABS_API_KEY       → voice generation (TTS), speech-to-text, lip sync
#   STABILITY_API_KEY        → images, thumbnails, upscaling, music, sound effects
#   AZURE_SPEECH_KEY         → voice generation (neural TTS), speech-to-text
#   AZURE_SPEECH_REGION        (both keys required together)
#   PEXELS_API_KEY           → stock video/image search
#   UNSPLASH_ACCESS_KEY      → stock image search
#
# Wiring a provider in a later phase = implement call() for its slot
# (see src/lib/ai/providers/slots.ts) — connectivity then reports "connected".
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
GOOGLE_API_KEY=
REPLICATE_API_TOKEN=
RUNWAY_API_KEY=
ELEVENLABS_API_KEY=
STABILITY_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
